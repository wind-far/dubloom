{
  "name": "dubloom-studio",
  "description": "Dubloom Studio - a local creator workspace for line-by-line dubbing review",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev:api": "uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev:web": "npm --prefix apps/web run dev",
    "test:backend": "pytest backend/tests",
    "lint:web": "npm --prefix apps/web run lint",
    "build:web": "npm --prefix apps/web run build"
  }
}
